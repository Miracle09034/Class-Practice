{
  "name": "school-exam-app",
  "version": "1.0.0",
  "description": "Exam Application",
  "main": "main.js",
  "scripts": {
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.exam.app",
    "productName": "Exam Master",
    "files": [
      "index.html",
      "styles.css",
      "app.js",
      "main.js",
      "data/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
